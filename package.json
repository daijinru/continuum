{
  "name": "continuum",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=24.10.0"
  },
  "scripts": {
    "harness": "node scripts/harness.ts",
    "dev": "vite build apps/web && node --env-file-if-exists=.env apps/api/src/main.ts",
    "start": "node --env-file-if-exists=.env apps/api/src/main.ts",
    "build": "tsc --noEmit && vite build apps/web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages/*/src scripts tests",
    "db:migrate": "node scripts/migrate.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:codex": "node scripts/check-codex.ts",
    "desktop:package": "pnpm build && node scripts/package-desktop.mjs",
    "desktop:test": "node tests/desktop-lifecycle.mjs"
  },
  "dependencies": {
    "fastify": "5.6.2",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.55.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "45.5.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.49.0",
    "vite": "6.4.1"
  }
}
